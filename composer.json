{
    "name": "vagabit/fos-js-routing-security-bundle",
    "description": "Role-filtered and security.yaml access-control-aware route exposure for FOSJsRoutingBundle",
    "version": "1.0.0-alpha3",
    "type": "symfony-bundle",
    "license": "MIT",
    "authors": [
        {
            "name": "Martino Piccinato",
            "email": "m.piccinato@vagabit.com"
        }
    ],
    "require": {
        "php": ">=8.1",
        "symfony/framework-bundle": "^6.4 || ^7.0 || ^8.0",
        "symfony/security-bundle": "^6.4 || ^7.0 || ^8.0",
        "symfony/security-http": "^6.4 || ^7.0 || ^8.0",
        "symfony/security-core": "^6.4 || ^7.0 || ^8.0",
        "symfony/routing": "^6.4 || ^7.0 || ^8.0",
        "symfony/http-foundation": "^6.4 || ^7.0 || ^8.0",
        "symfony/cache": "^6.4 || ^7.0 || ^8.0",
        "symfony/yaml": "^6.4 || ^7.0 || ^8.0",
        "friendsofsymfony/jsrouting-bundle": "^3.0"
    },
    "require-dev": {
        "friendsofphp/php-cs-fixer": "^3.0",
        "phpunit/phpunit": "^9.6 || ^10.0",
        "symfony/browser-kit": "^6.4 || ^7.0 || ^8.0",
        "symfony/phpunit-bridge": "^6.4 || ^7.0 || ^8.0"
    },
    "scripts": {
        "test": "phpunit",
        "cs-check": "php-cs-fixer fix --dry-run --diff",
        "cs-fix": "php-cs-fixer fix"
    },
    "autoload": {
        "psr-4": {
            "Vagabit\\FOSJsRoutingSecurityBundle\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Vagabit\\FOSJsRoutingSecurityBundle\\Tests\\": "tests/"
        }
    },
    "config": {
        "allow-plugins": {
            "symfony/flex": true,
            "symfony/runtime": true
        },
        "sort-packages": true
    }
}
